# Copy this file to .env and fill in real values to enable SMTP mail sending
# Example uses a generic SMTP provider — replace values with your provider's settings.

# Set Django to use SMTP backend in production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP host and port
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587

# Use TLS or SSL (set only one to True)
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SMTP authentication (API key or username/password depending on provider)
# IMPORTANT: replace the placeholders below in your local .env (do NOT commit real secrets)
EMAIL_HOST_USER=geethikareddy.avuthu@gmail.com 
EMAIL_HOST_PASSWORD=geethu@1834
# From address shown in emails
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Optional: set REDIS_URL for production cache (used for OTP/resend limits)
# REDIS_URL=redis://localhost:6379/1

# Notes:
# - For Gmail you may need an App Password (and to enable 2FA) instead of your account password.
# - After creating .env, restart the Django server to apply env variable changes.
